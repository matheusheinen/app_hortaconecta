{
  "expo": {
    "name": "Horta Conecta",
    "slug": "horta-conecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.hortaconecta.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "br.com.hortaconecta.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Horta Conecta use a câmera para ler o QR Code de presença.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita selecionar sua foto de perfil e fotos das atividades para o Diário institucional.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "627ab6c3-dc85-4d2f-aa47-2287b70ea80e"
      }
    },
    "owner": "hortaconecta"
  }
}
